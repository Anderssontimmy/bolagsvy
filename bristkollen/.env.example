# Kopiera till .env.local. Allt är frivilligt lokalt.

# Sajtens adress (sitemap och metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase i EU-region. Tomt = väntelistan sparas i minnet.
# Hemlig nyckel: sb_secret_… (eller äldre service_role). Bara på servern.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Ärenden (Resend). Tomt = testläge lokalt, avstängt i produktion.
# Skarpt läge kräver alla variabler nedan utom ANTHROPIC_API_KEY, OCH Supabase-variablerna ovan.
RESEND_API_KEY=
UTSKICK_FRAN=Halvhyra.se <anmalan@halvhyra.se>
# Mottagning av hyresvärdens svar (Resend Receiving). MX-posten för domänen pekar på Resend.
SVAR_DOMAN=svar.halvhyra.se
# Hemligheten för webhooken email.received → /api/inkommande (börjar med whsec_).
RESEND_WEBHOOK_SECRET=
# Vercel skickar den som Bearer-token till /api/cron/dagligen.
CRON_SECRET=
# Signerar länkarna till ärendesidan. Lång slumpad text, byt aldrig när ärenden finns.
LANK_HEMLIGHET=
# Frivillig. Utan den skriver AI:n inte om beskrivningen och svar sammanfattas inte.
ANTHROPIC_API_KEY=
# Bara för webbläsartesterna. Sätt ALDRIG i drift.
# HALVHYRA_TESTLAGE=ja

# Plausible. Tomt = ingen statistik.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
